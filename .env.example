# ─────────────────────────────────────────────────────────────────────────────
# MAYANK CLASSES - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env locally or set these variables in Railway Dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Django Core Settings
SECRET_KEY=django-insecure-change-this-to-a-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=*,.railway.app,.up.railway.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://*.railway.app,https://*.up.railway.app,http://127.0.0.1:8000

# Google Gemini AI Chatbot API Key (Get from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (Leave empty for SQLite, or provide PostgreSQL URL)
# If you attach a PostgreSQL database plugin in Railway, DATABASE_URL is set automatically!
# DATABASE_URL=postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway

# Gmail SMTP Email Configuration (For auto-delivery of counseling receipts)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_google_app_password
DEFAULT_FROM_EMAIL=Mayank Classes <admissions@mayankclasses.com>
ADMIN_EMAIL_NOTIFICATION=your_admin_email@gmail.com
